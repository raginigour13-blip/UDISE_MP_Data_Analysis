----------------------------defining function data exploration----------------------------
def check_teaching_data(df):
    print(df.shape)
    print(df["pseudocode"].duplicated().sum())
    missing = df.isnull().sum()
    print("missing value:\n",missing[missing > 0])
    print("total teachers:",df["total_tch"].sum())
    print("school with zero teachers:",(df["total_tch"] == 0).sum())
    a=0
    teach_per_school = df.groupby("total_tch")["pseudocode"].size()
    for code ,value in teach_per_school.items():
        if code < 10 :
            a= value + a
    print("number of school with atmost 10 teacher",a)
    per_of_school_less = round((a/df.shape[0])*100,2)              
    print("Percentage of school with atmost 10 teacher",per_of_school_less)
    print("male teachers:",df["male"].sum())
    print("female teachers:",df["female"].sum())
    print("trangender teachers:",df["transgender"].sum())
    m_teach=df["male"].sum()
    f_teach=df["female"].sum()
    perc_of_f_teach = (f_teach/(m_teach+f_teach))*100
    print("total female teacher in %",round(perc_of_f_teach,2))
    perc_of_m_teach = (m_teach/(m_teach+f_teach))*100
    print("Total male teacher in %",round(perc_of_m_teach,2))
    print("regular teachers:",df["regular"].sum())
    print("contract teachers:",df["contract"].sum())
    print("part_time teachers:",df["part_time"].sum())
    regu_teach = df["regular"].sum()
    contract_teach = df["contract"].sum()
    part_t_teach = df["part_time"].sum()
    perc_of_r_teach = (regu_teach/(regu_teach+contract_teach+part_t_teach))*100
    perc_of_c_teach = (contract_teach/(regu_teach+contract_teach+part_t_teach))*100
    perc_of_p_teach = (part_t_teach/(regu_teach+contract_teach+part_t_teach))*100
    print("% of regular teacher",round(perc_of_r_teach,2))
    print("% of contract teacher",round(perc_of_c_teach,2))
    print("% of part time teacher",round(perc_of_p_teach,2))
    print("teachers with B.Ed qualification:",df["bed_equivalent"].sum())
    print("teachers with trained CWSN:",df["trained_cwsn"].sum())

-----------------------defining function for storing raw data into list formate------------------------
def teach_data_summary(df,results:list[pd.DataFrame],district_name: str,year: str):
    results.append({
        "year":year,
        "district_name":district_name,
        "catch":"total school",
        "value":df.shape[0]
    })
    results.append({
    "year":year,
    "district_name":district_name,
    "catch":"total teachers",
    "value":df["total_tch"].sum()
     })
    results.append({
    "year":year,
    "district_name":district_name,
    "catch":"school with zero teacher",
    "value":(df["total_tch"] == 0).sum()
    })
    a=0
    teach_per_school = df.groupby("total_tch")["pseudocode"].size()
    for code ,value in teach_per_school.items():
        if code < 10 :
            a= value + a
    per_of_school_less = round((a/df.shape[0])*100,2)    
    results.append({
        "year":year,
        "district_name":district_name,
        "catch":"school with atmost 10 teachers",
        "value":a
        })
    results.append({
        "year":year,
        "district_name":district_name,
        "catch":"perctage school with atmost 10 teachers",
        "value":per_of_school_less
        })
    m_teach=df["male"].sum()
    f_teach=df["female"].sum()
    results.append({
    "year":year,
    "district_name":district_name,
    "catch":"female teacher in numbers",
    "value": f_teach
    })
    results.append({
    "year":year,
    "district_name":district_name,
    "catch":"male teacher in numbers",
    "value": m_teach
    })
    perc_of_f_teach = (f_teach/(m_teach+f_teach))*100
    perc_of_m_teach = (m_teach/(m_teach+f_teach))*100
    results.append({
    "year":year,
    "district_name":district_name,
    "catch":"female teacher in %",
    "value": round(perc_of_f_teach,2)
    })
    results.append({
    "year":year,
    "district_name":district_name,
    "catch":"male teacher in %",
    "value": round(perc_of_m_teach,2)
    })
    regu_teach = df["regular"].sum()
    contract_teach = df["contract"].sum()
    part_t_teach = df["part_time"].sum()
    perc_of_r_teach = (regu_teach/(regu_teach+contract_teach+part_t_teach))*100
    perc_of_c_teach = (contract_teach/(regu_teach+contract_teach+part_t_teach))*100
    perc_of_p_teach = (part_t_teach/(regu_teach+contract_teach+part_t_teach))*100
    results.append({
    "year":year,
    "district_name":district_name,
    "catch":"regular teacher in number",
    "value": round(regu_teach,2)
    })
    results.append({
    "year":year,
    "district_name":district_name,
    "catch":"part time teacher in number",
    "value": round(part_t_teach,2)
    })
    results.append({
    "year":year,
    "district_name":district_name,
    "catch":"contract teacher in number",
    "value": round(contract_teach,2)
    })
    results.append({
    "year":year,
    "district_name":district_name,
    "catch":"regular teacher in %",
    "value": round(perc_of_r_teach,2)
    })
    results.append({
    "year":year,
    "district_name":district_name,
    "catch":"part time teacher in %",
    "value": round(perc_of_p_teach,2)
    })
    results.append({
    "year":year,
    "district_name":district_name,
    "catch":"contract teacher in %",
    "value": round(perc_of_c_teach,2)
    })
    results.append({
    "year":year,
    "district_name":district_name,
    "catch":"teacher with B.ED or equivalent in number",
    "value": df["bed_equivalent"].sum()
    })
    results.append({
    "year":year,
    "district_name":district_name,
    "catch":"teachers with trained CWSN in numbers",
    "value": df["trained_cwsn"].sum()
    })
    summary = pd.DataFrame(results)
    print(summary)

