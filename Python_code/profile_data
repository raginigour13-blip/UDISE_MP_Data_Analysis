------------------defining function for exploring the data in excel files ------------------
def profile_explore(df):
    print("number of columns and rows :\n ",df.shape)      
    print("Is indexing code is duplicate or not?",df["pseudocode"].duplicated().sum())
    print("null values in :",df["pseudocode"].isnull().sum())
    print("Number of unique pseudocode:",df["pseudocode"].nunique())
    if "school_type" in df.columns:
        print("type of school:",df.groupby("school_type")["pseudocode"].count(),"\n(Code 1) = Managed by the State Government \n(Code 2) = Managed by the Tribal Welfare Department \n(Code 3)=Managed by Local Bodies ")
    else:
        return "Not Available"
    if "lowclass" in df.columns: 
        print("lowest class in the school:",df.groupby("lowclass")["pseudocode"].count())
        lc =df.groupby("lowclass")["pseudocode"].count()
    else:
        return "Not Available"
    if "highclass" in df.columns:
        print("highest class in the school:",df.groupby("highclass")["pseudocode"].count())
    else:
        return "Not Available"
    if "certified_fit_india_yn" in df.columns:
        print("School certified as Fit India School :",df.groupby("certified_fit_india_yn")["pseudocode"].count(),"\n1 = YES \n2 = NO \n9 = UNKNOWN ")
    else:
        return "Not Available"
    if "lowclass" in df.columns:
        print("School provides any vocational training under NSQF :",df.groupby("is_nsqf")["pseudocode"].count(),"\n1 = YES \n2 = NO \n9 = UNKNOWN ")
    else:
        return "Not available"
    
-------------defining function to comvert data from raw numbers to list form-----------------    
def profile_summary(df,result: list[pd.DataFrame],district_name,year:str):
    result.append({
        "year":year,
        "district_name":district_name,
        "catch":"number of columns",
        "value":df.shape[0]         
    })
    result.append({
        "year":year,
        "district_name":district_name,
        "catch":"number of rows",
        "value":df.shape[1]         
    })
    if "school_type" in df.columns:
        owernship_type =df.groupby("school_type")["pseudocode"].count()   
        result.append({
            "year":year,
            "district_name":district_name,
            "catch":"school managed by state govt",
            "value":owernship_type.get(1,"Not Available")
        })
        result.append({
            "year":year,
            "district_name":district_name,
            "catch":"school managed by Tribal Welfare Department",
            "value":owernship_type.get(2,"Not Available")
        })
        result.append({
            "year":year,
            "district_name":district_name,
            "catch":"school managed by Local bodies",
            "value":owernship_type.get(3,"Not Available")
        })
    else:
        result.append({
            "year":year,
            "district_name":district_name,
            "catch":"school_column",
            "value":"not available in this table"
        })
    if "lowclass" in df.columns:
        lc = df.groupby("lowclass")["pseudocode"].count()
        for lowclass, value in lc.items():
            result.append({
                "year": year,
                "district_name": district_name,
                "catch": f"{lowclass} class is starting class of school",
                "value": value
                })
    else:
        result.append({
            "year": year,
            "district_name": district_name,
            "catch": "lowest class in school is pseudocode",
            "value":"not available"
        })
    if "highclass" in df.columns:
            hc = df.groupby("highclass")["pseudocode"].count()
            for highclass,value in hc.items():
                result.append({
                    "year": year,
                    "district_name": district_name,
                    "catch": f"{highclass} class is end class of school",
                    "value": value
                })                
    else:
        result.append({
                    "year": year,
                    "district_name": district_name,
                    "catch": "highclass",
                    "value":"not available"
                })        
    if "certified_fit_india_yn" in df.columns:
        cert_fit_india = df.groupby("certified_fit_india_yn").size()
        for code,value in cert_fit_india.items():
            result.append({
                "year": year,
                "district_name": district_name,
                "catch": f"School certified as Fit India School code:{code}| 1=Yes ,2= No,3= Unknown",
                "value": value
                })                      
    else:
        result.append({
                    "year": year,
                    "district_name": district_name,
                    "catch": "certified_fit_india_yn",
                    "value":"not available"
                })                    
    if "is_nsqf" in df.columns:
        nsqf =df.groupby("is_nsqf").size()
        for code,value in nsqf.items():
            result.append({
                "year": year,
                "district_name": district_name,
                "catch": f"School provides any vocational training under NSQF:{code}| 1=Yes ,2= No,3= Unknown",
                "value": value
                })  
    else:
        result.append({
                    "year": year,
                    "district_name": district_name,
                    "catch": "is_nsqf",
                    "value":"not available"
                })
    result =pd.DataFrame(result)
    print(result)                
    
------------------defining function to compare data between 2 different excel file--------------   
def compare_two_CSV(df1,year1: str,df2, year2:str):   
    print(f"length of column in{year1}:",len(df1.columns))
    print(f"length of column in {year2}:",len(df2.columns))
    print("missing columns:\n",set(df1.columns) - set(df2.columns))
    if df1["pseudocode"].reset_index(
        drop=True).equals(df2["pseudocode"].reset_index(drop=True)):
        print("True")
    else:
        print("pseudocode is not same for both table")

----------------defining function for missing value identification---------------
def missing_value(df):
    missing = df.isnull().sum()
    for value,number in missing.items():
        if(number >0):
            print(f"{value} : {number}")
    print("Count the missing value \n",df["rural_urban"].value_counts(dropna=False))
    print("understanding the group by data \n",
    df.groupby("rural_urban")["pseudocode"]
      .count())
    if "district"in df.columns:
        print("data validation stage \n",df["district"].value_counts())
    if "block" in df.columns :
        print("how block data is distributed\n ",df["block"].value_counts())

