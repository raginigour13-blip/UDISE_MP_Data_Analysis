----------------------defining function for student analysis----------------------------
def total_student_anaylsis(df,school_data: list[pd.DataFrame],district_name: str, year: str):
    c = 0
    for c in range (0,13): 
        if c == 0:
            b_stud= df["cpp_b"].sum()
            g_stud= df["cpp_g"].sum()
            perc_of_male = round((b_stud/(b_stud+g_stud))*100,2)
            perc_of_female = round((g_stud/(b_stud+g_stud))*100,2)
            total_student =b_stud+g_stud
            school_data.append({
                "year":year,
                "district_name":district_name,
                "class":"primary",
                "male_student":b_stud,
                "female_student":g_stud,
                "percentage of male":perc_of_male,
                "percentage of female":perc_of_female,
                "total student":total_student,
                "enrollment_as_compare to previous year":0,
                "percentage of enrollment as compare to py":0
            })
            c+=1
        else:
            b_stud= df[f"c{c}_b"].sum()
            g_stud= df[f"c{c}_g"].sum()
            total_student =b_stud+g_stud
            perc_of_male = round((b_stud/(b_stud+g_stud))*100,2)
            perc_of_female = round((g_stud/(b_stud+g_stud))*100,2)
            if (c == 1):
                pr_year_student= df["cpp_b"].sum()+df["cpp_g"].sum()
                enroll_stud = (total_student - pr_year_student)
                perc_of_enroll_stud =round((enroll_stud/total_student)*100,2)
            else:
                a =c-1
                pr_year_student = df[f"c{a}_b"].sum()+df[f"c{a}_g"].sum()
                enroll_stud = total_student -pr_year_student
                perc_of_enroll_stud =round((enroll_stud/total_student)*100,2)
            school_data.append({
                "year":year,
                "district_name":district_name,      
                "class":f"class_{c}",
                "male_student":b_stud,
                "female_student":g_stud,
                "percentage of male":perc_of_male,
                "percentage of female":perc_of_female,
                "total student":total_student ,
                "enrollment_as_compare to previous year":enroll_stud,
                "percentage of enrollment as compare to py":perc_of_enroll_stud
            })
        c+=1
    anaysis_student = pd.DataFrame(school_data)
    print(anaysis_student)

