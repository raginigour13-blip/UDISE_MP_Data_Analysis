/* creating view of existing data for monitoring and evaluation of the data*/
CREATE VIEW Profile_pivot AS
with profile_summary as(
SELECT 
    a.year,
    a.catch as categories,
    a.value as Alirajpur_values,
    b.value as Bhopal_values,
    h.value as Harda_values,
    i.value as Indore_values,
    m.value as Mandla_values,
    u.value as Ujjain_values
FROM profile_aliraj_summary a
LEFT JOIN profile_bhopal_summary b
    ON a.catch = b.catch
    AND a.year = b.year

LEFT JOIN profile_harda_summary h
    ON a.catch = h.catch
    AND a.year = h.year

LEFT JOIN profile_indore_summary i
    ON a.catch = i.catch
    AND a.year = i.year

LEFT JOIN profile_mandla_summary m
    ON a.catch = m.catch
    AND a.year = m.year

LEFT JOIN profile_ujjain_summary u
    ON a.catch = u.catch
    AND a.year = u.year
    )
   
SELECT
    categories,

    -- ALIRAJPUR
    COALESCE(MAX(CASE WHEN year = '2023-24'
        THEN Alirajpur_values END), 0) AS Alirajpur_2023_24,

    COALESCE(MAX(CASE WHEN year = '2024-25'
        THEN Alirajpur_values END), 0) AS Alirajpur_2024_25,

    COALESCE(MAX(CASE WHEN year = '2025-26'
        THEN Alirajpur_values END), 0) AS Alirajpur_2025_26,


    -- BHOPAL
    COALESCE(MAX(CASE WHEN year = '2023-24'
        THEN Bhopal_values END), 0) AS Bhopal_2023_24,

    COALESCE(MAX(CASE WHEN year = '2024-25'
        THEN Bhopal_values END), 0) AS Bhopal_2024_25,

    COALESCE(MAX(CASE WHEN year = '2025-26'
        THEN Bhopal_values END), 0) AS Bhopal_2025_26,


    -- HARDA
    COALESCE(MAX(CASE WHEN year = '2023-24'
        THEN Harda_values END), 0) AS Harda_2023_24,

    COALESCE(MAX(CASE WHEN year = '2024-25'
        THEN Harda_values END), 0) AS Harda_2024_25,

    COALESCE(MAX(CASE WHEN year = '2025-26'
        THEN Harda_values END), 0) AS Harda_2025_26,


    -- INDORE
    COALESCE(MAX(CASE WHEN year = '2023-24'
        THEN Indore_values END), 0) AS Indore_2023_24,

    COALESCE(MAX(CASE WHEN year = '2024-25'
        THEN Indore_values END), 0) AS Indore_2024_25,

    COALESCE(MAX(CASE WHEN year = '2025-26'
        THEN Indore_values END), 0) AS Indore_2025_26,


    -- MANDLA
    COALESCE(MAX(CASE WHEN year = '2023-24'
        THEN Mandla_values END), 0) AS Mandla_2023_24,

    COALESCE(MAX(CASE WHEN year = '2024-25'
        THEN Mandla_values END), 0) AS Mandla_2024_25,

    COALESCE(MAX(CASE WHEN year = '2025-26'
        THEN Mandla_values END), 0) AS Mandla_2025_26,


    -- UJJAIN
    COALESCE(MAX(CASE WHEN year = '2023-24'
        THEN Ujjain_values END), 0) AS Ujjain_2023_24,

    COALESCE(MAX(CASE WHEN year = '2024-25'
        THEN Ujjain_values END), 0) AS Ujjain_2024_25,

    COALESCE(MAX(CASE WHEN year = '2025-26'
        THEN Ujjain_values END), 0) AS Ujjain_2025_26

FROM profile_summary
where categories NOT in( 'is_nsqf' , 'certified_fit_india_yn')
GROUP BY categories

